# ==========================================
# TraverseBD Environment Configuration Template
# ==========================================
# Copy this file to .env.local and populate with your credentials.

# Supabase Configuration (Optional for Cloud DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Integration Defaults
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=8801627444330

# ==========================================
# Fixed Administrator Credentials
# ==========================================
# Used for fixed login in development and deployment
ADMIN_EMAIL=admin@traversebd.com
ADMIN_PASSWORD=Admin@Traverse2026!

# ==========================================
# Cloudinary Storage Configuration
# ==========================================
# Populate with your Cloudinary credentials for cloud image management
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
