# ==========================================
# TraverseBD Environment Configuration Template
# ==========================================
# DO NOT ADD REAL SECRETS TO THIS FILE.
# Copy this file to .env.local and populate with your real credentials.

# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for backend administrative operations and database migrations/seeds
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Integration Defaults
# Format: International phone number without + or special characters (e.g., 8801712345678)
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=8801700000000
